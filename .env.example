# Copy this file to .env and replace placeholders locally. Never commit .env.
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
# Decimal Discord user ID for the single AEGIS owner; blank disables owner access.
OWNER_ID=YOUR_DISCORD_USER_ID
# Default prefix for servers without a saved custom prefix.
AEGIS_PREFIX=a!
# Optional HTTPS URLs; leave blank to omit support/invite links from embeds.
AEGIS_SUPPORT_URL=
AEGIS_INVITE_URL=
# SQLite database path.
AEGIS_DB_PATH=data/moderation.sqlite3
# Optional JSON object mapping server IDs to jail-role IDs, e.g. {"123":"456"}.
AEGIS_JAIL_ROLE_IDS={}
# Lavalink is optional; music remains unavailable without a configured password.
LAVALINK_URI=http://127.0.0.1:2333
LAVALINK_PASSWORD=YOUR_LAVALINK_PASSWORD
